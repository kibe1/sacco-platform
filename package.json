{
  "name": "sacco-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "platform:up": "docker compose up",
    "platform:up:detached": "docker compose up -d",
    "platform:down": "docker compose down",
    "platform:logs": "docker compose logs -f",
    "dev:member": "npm run dev --workspace=@sacco/member-portal",
    "dev:admin": "npm run dev --workspace=@sacco/admin-portal",
    "dev:mobile": "npm run dev --workspace=@sacco/mobile-app",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
